{
  "expo": {
    "name": "PoopTracker",
    "slug": "PoopTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucatrab1905.pooptracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PoopTracker uses your location to record where you took a shit.",
        "NSLocationAlwaysUsageDescription": "PoopTracker uses your location to record where you took a shit.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PoopTracker uses your location to record where you took a shit."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "967ad8d6-a0a2-449a-99ce-a1aab162d711"
      }
    }
  }
}
